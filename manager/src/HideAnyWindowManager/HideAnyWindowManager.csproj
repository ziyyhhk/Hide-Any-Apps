<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HideAnyWindowManager</RootNamespace>
    <Product>Hide Any Apps</Product>
    <AssemblyTitle>Hide Any Apps</AssemblyTitle>
    <Description>Auto-hide any normal Windows app. Background service plus manager.</Description>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <!-- x64 + ARM64 only. x86 is dropped: SetWindowLongPtrW does not exist on 32-bit
         (it's a macro over SetWindowLongW), so WindowMinSize would silently no-op there.
         The solution only ever builds x64 anyway. -->
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Compiler warnings (including nullable) fail the build to stop regressions;
         analyzer (CAxxxx) suggestions stay warnings so style doesn't block builds. -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- Trimming would strip the managed framework, but this build SDK does not
         ship ILLink.Tasks, so it would silently do nothing. JSON still uses
         source generation (ConfigJsonContext) — zero cost, trim-ready later.
         The big win is delete-list pruning in dist/build-release.ps1. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>
</Project>
